{
  "manifest_version": 3,
  "name": "ERP PassVault - Quản lý Mật khẩu & Auto-Fill",
  "version": "1.0.0",
  "description": "Tiện ích quản lý mật khẩu an toàn, tra cứu nhanh, tạo mật khẩu mạnh và tự động điền form đăng nhập liên kết với hệ thống ERP Doanh Nghiệp.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ERP PassVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
